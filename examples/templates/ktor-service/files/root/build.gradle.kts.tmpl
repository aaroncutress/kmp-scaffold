plugins {
    kotlin("jvm") version "{{ .Versions.kotlin }}"
    kotlin("plugin.serialization") version "{{ .Versions.kotlin }}"
    application
}

group = "{{ .Project.Package }}"
version = "1.0.0"

// Declared once rather than repeated on every line. `kmp-scaffold add tests`
// adds a Ktor dependency to a project generated without one, and it has no way
// to resolve a version at that point - so the version has to already be here.
val ktorVersion = "{{ .Versions.ktor }}"

application {
    mainClass.set("{{ .Project.Package }}.ApplicationKt")
}

repositories {
    mavenCentral()
}

dependencies {
    implementation("io.ktor:ktor-server-core:$ktorVersion")
    implementation("io.ktor:ktor-server-netty:$ktorVersion")
    implementation("io.ktor:ktor-server-config-yaml:$ktorVersion")
    implementation("io.ktor:ktor-server-content-negotiation:$ktorVersion")
    implementation("io.ktor:ktor-serialization-kotlinx-json:$ktorVersion")
{{- if has .Vars.extras "logging" }}
    implementation("io.ktor:ktor-server-call-logging:$ktorVersion")
{{- end }}
{{- if has .Vars.extras "cors" }}
    implementation("io.ktor:ktor-server-cors:$ktorVersion")
{{- end }}
    implementation("io.insert-koin:koin-ktor:{{ .Versions.koin }}")
    implementation("org.jetbrains.kotlinx:kotlinx-coroutines-core:{{ .Versions.Of "kotlinx-coroutines" }}")
    implementation("ch.qos.logback:logback-classic:{{ .Versions.logback }}")

{{- if .Tests }}

    testImplementation(kotlin("test"))
    testImplementation("io.ktor:ktor-server-test-host:$ktorVersion")
{{- end }}

    // kmp-scaffold:test-deps
}

kotlin {
    jvmToolchain(21)
}
