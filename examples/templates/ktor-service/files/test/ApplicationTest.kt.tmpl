package {{ .Project.Package }}

import io.ktor.client.request.get
import io.ktor.client.statement.bodyAsText
import io.ktor.http.HttpStatusCode
import io.ktor.server.testing.testApplication
import kotlin.test.Test
import kotlin.test.assertEquals

/**
 * Ktor's testApplication runs the whole server in-process, with no port bound -
 * so this exercises real routing and serialisation without being a slow test.
 */
class ApplicationTest {

    @Test
    fun `{{ index .Vars.routes 0 }} responds`() = testApplication {
        application { module() }

        val response = client.get("/{{ index .Vars.routes 0 }}")
        assertEquals(HttpStatusCode.OK, response.status)
        assertEquals(true, response.bodyAsText().isNotBlank())
    }
}
