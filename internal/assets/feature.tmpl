{{define "feature/Route.kt"}}
package {{ .Spec.Package }}.feature.{{ .Feature.Pkg }}.api

{{ if .Feature.RootTab -}}
import {{ .Spec.Package }}.core.navigation.RootRoute
{{ else -}}
import {{ .Spec.Package }}.core.navigation.Presentation
import {{ .Spec.Package }}.core.navigation.Route
{{ end -}}
import {{ .Spec.Package }}.core.navigation.routeSerializers
{{ if not .Feature.RootTab -}}
import kotlinx.parcelize.IgnoredOnParcel
{{ end -}}
import kotlinx.parcelize.Parcelize
import kotlinx.serialization.Serializable
import kotlinx.serialization.modules.SerializersModule
import kotlinx.serialization.modules.subclass

{{ if .Feature.RootTab -}}
@Serializable
@Parcelize
data object {{ .Feature.Pascal }}Route : RootRoute
{{- else -}}
@Serializable
@Parcelize
data object {{ .Feature.Pascal }}Route : Route {
    @IgnoredOnParcel
    override val presentation = Presentation.{{ .Feature.PresentationConst }}
}
{{- end }}

/**
 * Register every Route added to this file here as well.
 *
 * Navigation 3 serialises the back stack polymorphically, and [Route] is an
 * interface spanning modules rather than a sealed class, so an unregistered
 * route silently fails to save - the back stack resets to the start
 * destination on rotation or process death.
 */
val {{ .Feature.Camel }}NavSerializers: SerializersModule = routeSerializers {
    subclass({{ .Feature.Pascal }}Route::class)
}
{{end}}


{{define "feature/Navigation.kt"}}
package {{ .Spec.Package }}.feature.{{ .Feature.Pkg }}.impl

{{- if or .Feature.IsSheet .Feature.IsDialog }}
import androidx.compose.material3.ExperimentalMaterial3Api
{{- end }}
import androidx.navigation3.runtime.EntryProviderScope
import androidx.navigation3.runtime.NavKey
{{- if .Feature.IsSheet }}
import {{ .Spec.Package }}.core.navigation.BottomSheetSceneStrategy
{{- else if .Feature.IsDialog }}
import {{ .Spec.Package }}.core.navigation.DialogSceneStrategy
{{- else }}
import {{ .Spec.Package }}.core.navigation.SharedRoute
{{- end }}
import {{ .Spec.Package }}.feature.{{ .Feature.Pkg }}.api.{{ .Feature.Pascal }}Route

/**
 * This module's contribution to the app's entryProvider. Called from App.kt.
 */
{{ if or .Feature.IsSheet .Feature.IsDialog }}@OptIn(ExperimentalMaterial3Api::class)
{{ end }}fun EntryProviderScope<NavKey>.{{ .Feature.Camel }}Entries() {
{{- if .Feature.IsSheet }}
    entry<{{ .Feature.Pascal }}Route>(
        metadata = BottomSheetSceneStrategy.bottomSheet(
            enabledValues = BottomSheetSceneStrategy.FullHeightOnly
        )
    ) {
        {{ .Feature.Pascal }}Screen()
    }
{{- else if .Feature.IsDialog }}
    entry<{{ .Feature.Pascal }}Route>(metadata = DialogSceneStrategy.dialog()) {
        {{ .Feature.Pascal }}Screen()
    }
{{- else }}
    entry<{{ .Feature.Pascal }}Route> {
        // SharedRoute makes shared-element transitions available to this screen.
        SharedRoute {
            {{ .Feature.Pascal }}Screen()
        }
    }
{{- end }}
}
{{end}}


