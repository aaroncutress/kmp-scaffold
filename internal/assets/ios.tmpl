{{define "ios/Config.xcconfig"}}
// Set TEAM_ID to your Apple Developer team identifier. Leaving it blank works
// for the simulator; a device build needs it (or set the team in Xcode's
// Signing & Capabilities tab, which writes it here).
TEAM_ID=

PRODUCT_NAME={{ .Spec.TypePrefix }}
PRODUCT_BUNDLE_IDENTIFIER={{ .Spec.ApplicationID }}.{{ .Spec.TypePrefix }}$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0
{{end}}


{{define "ios/iOSApp.swift"}}
import SwiftUI
import {{ .Spec.FrameworkName }}

@main
struct iOSApp: App {

    init() {
{{- if .Spec.HasSharedUtil "ios-koin-helper" }}
        // Start the shared dependency graph before any view can ask for a
        // ViewModel. Kotlin's KoinHelper is a singleton, hence `.shared`.
        KoinHelper.shared.setup()
{{- end }}
    }

    var body: some Scene {
        WindowGroup {
            ContentView()
        }
    }
}
{{end}}


{{define "ios/ContentView.swift"}}
import SwiftUI
import {{ .Spec.FrameworkName }}

struct ContentView: View {

    var body: some View {
        NavigationStack {
            VStack(spacing: 16) {
                Image(systemName: "swift")
                    .font(.system(size: 64))
                    .foregroundColor(.accentColor)

                Text("{{ .Spec.Name }}")
                    .font(.largeTitle.bold())

                Text(platformName)
                    .font(.footnote)
                    .foregroundStyle(.secondary)
            }
            .frame(maxWidth: .infinity, maxHeight: .infinity)
            .navigationTitle("{{ .Spec.Name }}")
            .navigationBarTitleDisplayMode(.inline)
        }
    }

    /// Anything in `sharedLogic/src/commonMain` is callable from here. Kotlin
    /// top-level functions are exported as `<FileName>Kt`, so `currentPlatform()`
    /// in `Platform.kt` arrives as `PlatformKt.currentPlatform()`.
    private var platformName: String {
        PlatformKt.currentPlatform().name
    }
}

#Preview {
    ContentView()
}
{{end}}


