{{define "iosfeatures/Package.swift"}}
// swift-tools-version: 5.9
import PackageDescription

// Every feature depends on the same three things: the shared route payloads,
// the Kotlin Multiplatform framework, and the SwiftUI bridge for its
// ViewModels. Declaring that once keeps the target list readable and makes it
// obvious when a target reaches for something it should not - a feature must
// never depend on another feature.
let featureDependencies: [Target.Dependency] = [
    "CoreNavigation",
    "{{ .Spec.FrameworkName }}",
    .product(name: "KMPObservableViewModelSwiftUI", package: "KMP-ObservableViewModel"),
]

let package = Package(
    name: "Features",
    platforms: [.iOS(.{{ .IOSDeploymentMajor }})],
    products: [
        // One product per target, so a single feature can be imported on its
        // own in a preview, a test, or another package.
        .library(name: "CoreNavigation", targets: ["CoreNavigation"]),
        .library(name: "{{ .Spec.FrameworkName }}", targets: ["{{ .Spec.FrameworkName }}"]),
{{- range .Tabs }}
        .library(name: "{{ .Pascal }}", targets: ["{{ .Pascal }}"]),
{{- end }}
        // kmp-scaffold:ios-products

        // What the app target links: one product covering every feature. The
        // Xcode project references this and nothing else, so adding a feature
        // never touches project.pbxproj - which matters, because Xcode rewrites
        // that file whenever it saves.
        .library(name: "AppFeatures", targets: [
            "CoreNavigation",
{{- range .Tabs }}
            "{{ .Pascal }}",
{{- end }}
            // kmp-scaffold:ios-app-features
        ]),
    ],
    dependencies: [
        .package(
            url: "https://github.com/rickclephas/KMP-ObservableViewModel",
            from: "{{ .ObservableViewModelSwiftVersion }}"
        ),
    ],
    targets: [
        // The Kotlin Multiplatform framework, built by Gradle.
        //
        // Swift Package Manager resolves this path before any Xcode build phase
        // runs, so the XCFramework has to exist before the first build: run
        // `iosApp/build-framework.sh` once after cloning. After that the app's
        // "Build Kotlin Framework" phase keeps it current.
        .binaryTarget(
            name: "{{ .Spec.FrameworkName }}",
            path: "../../Frameworks/{{ .Spec.FrameworkName }}.xcframework"
        ),

        // Route payloads and the Koin bridge. Every feature imports this; it
        // imports no feature, which is what keeps the graph acyclic.
        .target(
            name: "CoreNavigation",
            dependencies: [
                "{{ .Spec.FrameworkName }}",
                .product(name: "KMPObservableViewModelSwiftUI", package: "KMP-ObservableViewModel"),
            ]
        ),
{{ range .Tabs }}
        .target(name: "{{ .Pascal }}", dependencies: featureDependencies),
{{- end }}
        // kmp-scaffold:ios-targets
    ]
)
{{end}}


{{define "iosfeatures/Resolve.swift"}}
import {{ .Spec.FrameworkName }}

/// Resolves a dependency from the shared Koin graph.
///
/// Shared ViewModels are constructed by Koin, and their Kotlin constructors are
/// `internal` - so they are not exported to Swift and cannot be built here. This
/// asks the graph for them instead, which is also what makes a ViewModel's
/// dependencies swappable from the Kotlin side without touching any Swift.
///
/// `KoinHelper.shared.setup()` must have run first; the app does that in
/// `iOSApp.init()`.
public func resolveShared<T: AnyObject>(_ type: T.Type) -> T {
    guard let objCClass = type as? AnyClass else {
        fatalError("\(type) is not an Objective-C visible class - is it exported from Kotlin?")
    }
    guard let instance = KoinHelper.shared.get(objCClass: objCClass) as? T else {
        fatalError("The shared Koin graph has no binding for \(type)")
    }
    return instance
}
{{end}}


{{define "iosfeatures/Route.swift"}}
{{- $f := .Feature }}
import Foundation

/// Where the {{ $f.Name }} screen can be navigated to from.
///
/// Routes live here, in CoreNavigation, rather than in the feature itself: that
/// is what lets any feature push this screen without importing the module that
/// implements it. Add stored properties for whatever the screen needs - they
/// travel with the route through `NavigationPath`.
public struct {{ $f.Pascal }}Route: Hashable {
    public init() {}
}
{{end}}


{{define "iosfeatures/Screen.swift"}}
{{- $f := .Feature }}
import CoreNavigation
{{- if $f.Shared }}
import KMPObservableViewModelSwiftUI
import {{ .Spec.FrameworkName }}
{{- end }}
import SwiftUI

struct {{ $f.Pascal }}Screen: View {
{{- if $f.Shared }}
    @StateViewModel private var viewModel: {{ $f.Pascal }}ViewModel

    init() {
        // Same ViewModel class the Android side collects from, so both platforms
        // see identical state.
        _viewModel = StateViewModel(wrappedValue: resolveShared({{ $f.Pascal }}ViewModel.self))
    }
{{- end }}

    var body: some View {
{{- if $f.Shared }}
        Group {
            if viewModel.uiState.isLoading {
                ProgressView()
            } else if let error = viewModel.uiState.error {
                ContentUnavailableView("Something went wrong", systemImage: "exclamationmark.triangle", description: Text(error))
            } else {
                Text(viewModel.uiState.message)
            }
        }
        .navigationTitle("{{ $f.Pascal }}")
{{- else }}
        VStack(spacing: 12) {
            Text("{{ $f.Pascal }}")
                .font(.title2.bold())
            Text("Replace this with the {{ $f.Name }} UI.")
                .foregroundStyle(.secondary)
        }
        .frame(maxWidth: .infinity, maxHeight: .infinity)
        .navigationTitle("{{ $f.Pascal }}")
{{- end }}
    }
}

#Preview {
    NavigationStack {
{{- if $f.Shared }}
        // The real screen resolves its ViewModel from Koin, which a preview has
        // no graph for - pull the body into a stateless subview to preview it.
        Text("{{ $f.Pascal }}")
{{- else }}
        {{ $f.Pascal }}Screen()
{{- end }}
    }
}
{{end}}


{{define "iosfeatures/Destination.swift"}}
{{- $f := .Feature }}
import CoreNavigation
import SwiftUI

public extension View {

    /// Renders the {{ $f.Name }} screen for a ``{{ $f.Pascal }}Route``.
    ///
    /// The screen itself stays `internal`: the app target only ever sees this
    /// modifier, so the feature can restructure its views without breaking the
    /// coordinator.
    ///
    /// To navigate from here to another feature, take a callback rather than
    /// importing it:
    ///
    /// ```swift
    /// func {{ $f.Camel }}Destination(
    ///     for route: {{ $f.Pascal }}Route,
    ///     onOpenDetail: @escaping (DetailRoute) -> Void
    /// ) -> some View {
    ///     {{ $f.Pascal }}Screen(onOpenDetail: onOpenDetail)
    /// }
    /// ```
    ///
    /// The coordinator then appends that route to the active tab's path, and the
    /// two features still know nothing about each other.
{{- if or $f.IsSheet $f.IsDialog }}
    ///
    /// On Android this route presents as a {{ if $f.IsSheet }}bottom sheet{{ else }}dialog{{ end }}. SwiftUI has no
    /// equivalent inside `NavigationPath`, so it is pushed here instead. To
    /// present it modally, drop its `.navigationDestination` from
    /// `AppDestinations` and drive a `.sheet(item:)` from the coordinator with
    /// an optional `{{ $f.Pascal }}Route` instead.
{{- end }}
    @ViewBuilder
    func {{ $f.Camel }}Destination(for route: {{ $f.Pascal }}Route) -> some View {
        {{ $f.Pascal }}Screen()
    }
}
{{end}}


{{define "iosfeatures/iOSApp.swift"}}
import SwiftUI
import {{ .Spec.FrameworkName }}

@main
struct iOSApp: App {

    init() {
{{- if .Spec.HasSharedUtil "ios-koin-helper" }}
        // Start the shared dependency graph before any view can ask for a
        // ViewModel. Deliberately not called `initKoin`: Kotlin/Native renames
        // anything starting with `init` when exporting to Objective-C.
        KoinHelper.shared.setup()
{{- end }}
    }

    var body: some Scene {
        WindowGroup {
            AppCoordinator()
        }
    }
}
{{end}}


{{define "iosfeatures/AppCoordinator.swift"}}
{{- range .IOSCoordinatorImports }}
import {{ . }}
{{- end }}

/// The tabs, and the state that decides which one is showing.
enum AppTab: Hashable {
{{- range .Tabs }}
    case {{ .Camel }}
{{- end }}
    // kmp-scaffold:ios-tab-cases
}

/// The root view: a tab bar over one navigation stack per tab.
///
/// Each tab keeps its own `NavigationPath`, which is what lets someone go deep
/// into one tab, switch away to another, and come back to exactly where they
/// were. A single shared path would flatten all of that into one history.
///
/// This mirrors the Android side, where every root route has its own back stack
/// under the adaptive navigation shell.
struct AppCoordinator: View {
    @State private var selectedTab: AppTab = .{{ (index .Tabs 0).Camel }}

{{- range .Tabs }}
    @State private var {{ .Camel }}Path = NavigationPath()
{{- end }}
    // kmp-scaffold:ios-tab-paths

    var body: some View {
        TabView(selection: $selectedTab) {
{{- range .Tabs }}
            NavigationStack(path: ${{ .Camel }}Path) {
                EmptyView()
                    .{{ .Camel }}Destination(for: {{ .Pascal }}Route())
                    .modifier(AppDestinations(path: ${{ .Camel }}Path))
            }
            .tabItem { Label("{{ .Label }}", systemImage: "{{ .Symbol }}") }
            .tag(AppTab.{{ .Camel }})
{{ end }}
            // kmp-scaffold:ios-tabs
        }
    }
}

/// Every destination that is not a tab root, registered on all of them.
///
/// Applying the same modifier to each stack means a pushed screen opens inside
/// whichever tab the user is already in, rather than yanking them to a
/// different one. `path` is here so a screen that navigates onwards can append
/// to the stack it is already on.
private struct AppDestinations: ViewModifier {
    @Binding var path: NavigationPath

    func body(content: Content) -> some View {
        content
            // kmp-scaffold:ios-destinations
    }
}
{{end}}


{{define "iosfeatures/build-framework.sh"}}
#!/bin/sh
#
# Builds the sharedLogic XCFramework and puts it where the Features package
# expects to find it.
#
# Xcode runs this as a build phase, but Swift Package Manager resolves the
# binary target's path *before* any build phase runs - so the framework has to
# exist before the first build. Run this once after cloning:
#
#     ./iosApp/build-framework.sh
#
set -eu

CONFIGURATION="${CONFIGURATION:-Debug}"
FRAMEWORK_NAME="{{ .Spec.FrameworkName }}"

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
LOWER_CONFIG=$(echo "$CONFIGURATION" | tr '[:upper:]' '[:lower:]')

echo "Assembling $FRAMEWORK_NAME.xcframework ($CONFIGURATION)..."
"$REPO_ROOT/gradlew" -p "$REPO_ROOT" ":sharedLogic:assemble${FRAMEWORK_NAME}${CONFIGURATION}XCFramework"

BUILT="$REPO_ROOT/sharedLogic/build/XCFrameworks/$LOWER_CONFIG/$FRAMEWORK_NAME.xcframework"
if [ ! -d "$BUILT" ]; then
    echo "error: Gradle did not produce $BUILT" >&2
    exit 1
fi

DEST="$SCRIPT_DIR/Frameworks"
mkdir -p "$DEST"
# Replace rather than merge, so a removed architecture does not linger.
rm -rf "$DEST/$FRAMEWORK_NAME.xcframework"
cp -R "$BUILT" "$DEST/$FRAMEWORK_NAME.xcframework"

echo "Wrote $DEST/$FRAMEWORK_NAME.xcframework"
{{end}}


{{define "iosfeatures/README.md"}}
# {{ .Spec.Name }} for iOS

A SwiftUI app built from one local Swift package with a target per feature.

## First run

```sh
./build-framework.sh          # once, before opening Xcode
open iosApp.xcodeproj
```

The first step is not optional. `Packages/Features/Package.swift` declares the
Kotlin framework as a `.binaryTarget`, and Swift Package Manager resolves that
path *before* Xcode runs any build phase — so the XCFramework has to be on disk
already. After that, the app's "Build Kotlin Framework" phase rebuilds it on
every build, and you only need to run the script by hand again if you change
the shared module's *API* while Xcode is open (a re-resolve picks it up).

## Layout

```
iosApp/
├── iosApp.xcodeproj
├── build-framework.sh          Gradle -> Frameworks/{{ .Spec.FrameworkName }}.xcframework
├── Frameworks/                 generated, gitignored
├── iosApp/
│   └── App/
│       ├── iOSApp.swift        @main, starts Koin
│       └── AppCoordinator.swift  TabView + one NavigationPath per tab
└── Packages/Features/
    ├── Package.swift
    └── Sources/
        ├── CoreNavigation/     route payloads + the Koin bridge
{{- range .Tabs }}
        ├── {{ .Pascal }}/
{{- end }}
        └── ...
```

## The dependency rule

```
              AppCoordinator (app target)
                        │
        ┌───────────────┼───────────────┐
        ▼               ▼               ▼
{{ range $i, $t := .Tabs }}{{ if $i }}      {{ end }}{{ $t.Pascal }}{{ end }}   ...
        │               │               │
        └───────────────┼───────────────┘
                        ▼
                 CoreNavigation
             (routes only, no views)
```

A feature never imports another feature. To open a screen that belongs to
someone else, take a callback and let the coordinator append the route:

```swift
struct ContactsScreen: View {
    let onOpenChat: (ChatRoute) -> Void      // ChatRoute comes from CoreNavigation
    ...
}
```

That is what keeps the build cache granular — editing one screen recompiles one
target — and makes each feature previewable and testable on its own.

## Adding a feature

```sh
kmp-scaffold add feature billing
```

which writes the target, its route and its destination wrapper, and wires them
into `Package.swift` and `AppCoordinator.swift`.
{{end}}


