{{- else if eq .Alias "androidLibrary" }}
    alias(libs.plugins.androidLibrary) apply false
{{- else if eq .Alias "androidMultiplatformLibrary" }}
    alias(libs.plugins.androidMultiplatformLibrary) apply false
{{- else if eq .Alias "composeCompiler" }}
    alias(libs.plugins.composeCompiler) apply false
{{- else if eq .Alias "kotlinMultiplatform" }}
    alias(libs.plugins.kotlinMultiplatform) apply false
{{- end }}
{{- end }}

{{- range .Cat.Plugins }}
{{- if eq .Alias "ksp" }}
    alias(libs.plugins.ksp) apply false
{{- else if eq .Alias "kotlin-serialization" }}
    alias(libs.plugins.kotlin.serialization) apply false
{{- else if eq .Alias "kotlin-parcelize" }}
    alias(libs.plugins.kotlin.parcelize) apply false
{{- else if eq .Alias "koin-compiler" }}
    alias(libs.plugins.koin.compiler) apply false
{{- else if eq .Alias "buildkonfig" }}
    alias(libs.plugins.buildkonfig) apply false
