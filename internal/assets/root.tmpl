{{define "root/gitattributes"}}
# Normalise line endings on the way into the repository, so a checkout on
# Windows and one on macOS produce the same working tree.
* text=auto eol=lf

# gradlew is executed by a shell. CRLF in it produces "bad interpreter", which
# is a confusing way to find out your editor rewrote the file.
gradlew text eol=lf
*.sh text eol=lf

# Batch files are run by cmd.exe, which wants CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary, so git neither converts line endings nor tries to diff them.
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.keystore binary
*.jks binary

gradle/wrapper/gradle-wrapper.jar binary

# project.pbxproj is deliberately left as ordinary text. `merge=union` is often
# suggested for it, and it does resolve conflicts automatically - by keeping
# both sides, which in an object graph produces a file Xcode cannot open. A
# conflict here is worth resolving by hand.
{{end}}
