{{define "buildSrc/build.gradle.kts"}}
plugins {
    `kotlin-dsl`
}

repositories {
    google()
    mavenCentral()
}

// These put the Android and Kotlin Gradle plugins on the buildscript classpath,
// which is what lets the convention plugins below (and the version-less plugin
// aliases in libs.versions.toml) resolve without repeating versions.
//
// Keep these in step with the `agp` and `kotlin` versions in
// gradle/libs.versions.toml - they are the same artifacts.
dependencies {
    implementation("com.android.tools.build:gradle:{{ .Res.V "agp" }}")
    implementation("org.jetbrains.kotlin:kotlin-gradle-plugin:{{ .Res.V "kotlin" }}")
{{- if .Spec.Android }}
    implementation("org.jetbrains.kotlin:compose-compiler-gradle-plugin:{{ .Res.V "kotlin" }}")
{{- end }}
}
{{end}}


{{define "buildSrc/secrets.gradle.kts"}}
import java.util.Properties

// Convention plugin: loads secrets.properties once and shares it with every
// module via rootProject.extra, so individual build.gradle.kts files don't
// each need their own Properties-loading boilerplate.
//
// Applied once, from the root build.gradle.kts:
//     plugins { id("{{ .Spec.Namespace }}.secrets") }
//
// secrets.properties lives at the repo root, next to settings.gradle.kts, and
// is gitignored. See secrets.properties.template for the expected keys.

val secretsProps = Properties().apply {
    val f = rootProject.file("secrets.properties")
    if (f.exists()) {
        f.inputStream().use { load(it) }
    } else {
        logger.warn("secrets.properties not found at repo root - using empty secrets")
    }
}

rootProject.extra["secretsProps"] = secretsProps
{{end}}


{{define "buildSrc/android.library.gradle.kts"}}
import org.gradle.api.artifacts.VersionCatalogsExtension

// Base convention for every Android library module: SDK levels and Java target
// live here rather than being repeated in each module's build script.

plugins {
    id("com.android.library")
}

val libs = extensions.getByType<VersionCatalogsExtension>().named("libs")

android {
    compileSdk = libs.findVersion("android-compileSdk").get().requiredVersion.toInt()

    defaultConfig {
        minSdk = libs.findVersion("android-minSdk").get().requiredVersion.toInt()
        testInstrumentationRunner = "androidx.test.runner.AndroidJUnitRunner"
    }

    compileOptions {
        sourceCompatibility = JavaVersion.VERSION_{{ .Spec.JVMTarget }}
        targetCompatibility = JavaVersion.VERSION_{{ .Spec.JVMTarget }}
    }
}
{{end}}


{{define "buildSrc/android.compose.gradle.kts"}}
import org.gradle.api.artifacts.VersionCatalogsExtension

// Adds Compose on top of the library convention.

plugins {
    id("{{ .Spec.Namespace }}.android.library")
    id("org.jetbrains.kotlin.plugin.compose")
}

val libs = extensions.getByType<VersionCatalogsExtension>().named("libs")

android {
    buildFeatures {
        compose = true
    }
}

dependencies {
    add("implementation", libs.findBundle("compose").get())
    add("debugImplementation", libs.findLibrary("androidx-compose-ui-tooling").get())
}
{{end}}


{{define "buildSrc/android.feature.gradle.kts"}}
import org.gradle.api.artifacts.VersionCatalogsExtension

// Everything a feature `impl` module needs: Compose, the shared modules, and
// the api modules of the other features so they can navigate to each other.

plugins {
    id("{{ .Spec.Namespace }}.android.compose")
}

val libs = extensions.getByType<VersionCatalogsExtension>().named("libs")

dependencies {
    // Shared feature logic and UI
    add("implementation", project(":core:ui"))
    add("implementation", project(":core:navigation"))
    add("implementation", project(":sharedLogic"))

    // Common feature dependencies
    add("implementation", libs.findBundle("navigation").get())
    add("implementation", libs.findBundle("koin").get())
    add("implementation", libs.findBundle("adaptive").get())
    add("implementation", libs.findBundle("ui-extras").get())
    add("implementation", libs.findBundle("utils").get())

    // API modules, so any feature can navigate to any other feature.
    // kmp-scaffold:feature-apis
{{- range .Tabs }}
    add("implementation", project(":feature:{{ .Name }}:api"))
{{- end }}
}
{{end}}


{{define "root/README.md"}}
# {{ .Spec.Name }}

A Kotlin Multiplatform project generated with
[kmp-scaffold](https://github.com/aaroncutress/kmp-scaffold) {{ .Gen }}.

## Layout

| Path | What lives there |
| --- | --- |
| `sharedLogic/` | Business logic, repositories and ViewModels shared by every platform. |
{{- if .Spec.Android }}
| `androidApp/` | The Android application: composition root, `MainActivity`, navigation wiring. |
| `core/navigation/` | `Route`, `Navigator`, back-stack state and the scene strategies. |
| `core/ui/` | Theme, design tokens and shared Compose components. |
| `feature/<name>/api/` | A feature's routes - what other features depend on to navigate to it. |
| `feature/<name>/impl/` | A feature's screens - depended on only by `androidApp`. |
{{- end }}
{{- if .Spec.IOS }}
{{- if .UsesIOSFeatures }}
| `iosApp/` | The SwiftUI application: the app target, plus `Packages/Features`, a local Swift package with one target per feature. |
{{- else }}
| `iosApp/` | The SwiftUI application. It links the `SharedLogic` framework built by Gradle. |
{{- end }}
{{- end }}
| `buildSrc/` | Convention plugins so module build scripts stay short. |
| `gradle/libs.versions.toml` | The single source of truth for every dependency version. |
{{- if .HasRunConfigurations }}
| `.run/` | JetBrains run configurations, so the IDE's run dropdown is populated on first open. Commit these. |
{{- end }}

## Running

{{ if .Spec.Android -}}
```bash
./gradlew :androidApp:installDebug
```
{{ end }}
{{- if and .Spec.IOS .UsesIOSFeatures }}
On iOS, build the shared framework once before the first Xcode build:

```bash
./iosApp/build-framework.sh
open iosApp/iosApp.xcodeproj
```

That order matters. Swift Package Manager resolves `SharedLogic.xcframework` as
a binary target *before* Xcode runs any build phase, so it has to be on disk
already - otherwise the first build fails with "Missing binary target". After
that, the app's `Compile Kotlin Framework` phase re-runs the script on every
build, so the framework stays current.

See [`iosApp/README.md`](iosApp/README.md) for how the Swift package is laid out.
{{- else if .Spec.IOS }}
Open `iosApp/iosApp.xcodeproj` in Xcode and run. The `Compile Kotlin Framework`
build phase runs `./gradlew :sharedLogic:embedAndSignAppleFrameworkForXcode`
for you, so the framework is always current.
{{- end }}

Run the shared tests with:

```bash
./gradlew :sharedLogic:allTests
```
{{ if .Spec.HasPack "secrets" }}
## Secrets

Copy `secrets.properties.template` to `secrets.properties` and fill it in.
Keys become `BuildKonfig` fields{{ if .Spec.Android }} and Android manifest placeholders{{ end }}.
`secrets.properties` is gitignored.
{{ end }}
## Adding to this project

```bash
kmp-scaffold add feature <name>     # a new feature module, wired end to end
kmp-scaffold add library            # add a dependency to the version catalog
kmp-scaffold versions               # check what has newer releases
```

## Toolchain notes

This project compiles to Java {{ .Spec.JVMTarget }}. That is what the code
targets, not what Gradle itself runs on - the daemon JVM is not pinned by
default. To pin it (and let Gradle provision it automatically), run:

```bash
./gradlew updateDaemonJvm --jvm-version={{ .Spec.JVMTarget }}
```
{{end}}


