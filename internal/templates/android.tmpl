{{define "android/proguard-rules.pro"}}
# Kotlinx serialization keeps its generated serializers via annotations, but R8
# still needs the companion Serializer objects reachable.
-keepattributes *Annotation*, InnerClasses
-dontnote kotlinx.serialization.**

-keepclassmembers class **$$serializer {
    *** INSTANCE;
}

# Navigation 3 restores the back stack by reflecting over Route types.
-keep class {{ .Spec.Package }}.**.*Route { *; }
-keep class {{ .Spec.Package }}.**.*Route$* { *; }
{{end}}


