import androidx.compose.runtime.Composable
import androidx.compose.runtime.CompositionLocalProvider
import androidx.compose.runtime.remember
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.navigation3.runtime.NavKey
import androidx.navigation3.runtime.entryProvider
import androidx.navigation3.ui.NavDisplay
{{- if .Spec.HasAndroidExtra "nav3-scenes" }}
import {{ .Spec.Package }}.core.navigation.BottomSheetSceneStrategy
import {{ .Spec.Package }}.core.navigation.DialogSceneStrategy
{{- end }}
import {{ .Spec.Package }}.core.navigation.LocalNavigator
import {{ .Spec.Package }}.core.navigation.LocalSharedTransitionScope
import {{ .Spec.Package }}.core.navigation.NavigationState
import {{ .Spec.Package }}.core.navigation.Navigator
