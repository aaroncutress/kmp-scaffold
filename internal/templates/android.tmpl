{{- end }}
{{- if .Spec.HasAndroidExtra "snackbar-host" }}
import {{ .Spec.Package }}.core.ui.components.LocalSnackbarHostState
{{- end }}
{{- if $shell }}
import {{ .Spec.Package }}.core.ui.components.ResponsiveNavigationShell
{{- end }}
{{- if and (.Spec.HasAndroidExtra "snackbar-host") $shell }}
import {{ .Spec.Package }}.core.ui.components.rememberSnackbarBottomPadding
{{- end }}
import {{ .Spec.Package }}.core.ui.theme.{{ .Spec.ThemeName }}
{{- range .Tabs }}
import {{ $.Spec.Package }}.feature.{{ .Pkg }}.api.{{ .Pascal }}Route
import {{ $.Spec.Package }}.feature.{{ .Pkg }}.impl.{{ .Camel }}Entries
{{- end }}

/**
 * The composition root.
 *
 * There are two NavDisplays: the outer one owns the global back stack (anything
 * pushed on top of the shell, plus sheets and dialogs), and the inner one owns
 * the current root's stack. Keeping them separate is what lets a pushed screen
 * cover the navigation bar while each tab still remembers its own history.
 */
@Composable
fun App() {
    {{ .Spec.ThemeName }} {
        Surface(
            modifier = Modifier.fillMaxSize(),
            color = MaterialTheme.colorScheme.background
        ) {
            val navigationState = rememberNavigationState(
                startRoot = {{ (first .Spec.RootTabs) | pascal }}Route,
                roots = setOf(
{{- range .Tabs }}
                    {{ .Pascal }}Route,
{{- end }}
                    // kmp-scaffold:roots
                ),
                savedStateConfiguration = appNavSavedStateConfiguration
            )
            val navigator = remember(navigationState) { Navigator(navigationState) }
{{- if .Spec.HasAndroidExtra "snackbar-host" }}
            val snackbarHostState = remember { SnackbarHostState() }
{{- end }}
{{- if .Spec.HasAndroidExtra "nav3-scenes" }}

            val bottomSheetStrategy = remember { BottomSheetSceneStrategy<NavKey>() }
            val dialogStrategy = remember { DialogSceneStrategy<NavKey>() }
{{- end }}
{{- if and (.Spec.HasAndroidExtra "snackbar-host") $shell }}

            // Whether the shell's own tabs are what is showing, as opposed to a
            // pushed screen - used to keep the snackbar clear of the nav bar
            // only while that bar is actually on screen.
            val isShellActive = navigationState.globalBackStack.lastOrNull() == ShellRoute
{{- end }}

            Box(modifier = Modifier.fillMaxSize()) {
                SharedTransitionLayout {
                    CompositionLocalProvider(
                        LocalNavigator provides navigator,
                        LocalSharedTransitionScope provides this@SharedTransitionLayout,
{{- if .Spec.HasAndroidExtra "snackbar-host" }}
                        LocalSnackbarHostState provides snackbarHostState,
{{- end }}
                    ) {
                        NavDisplay(
                            backStack = navigationState.globalBackStack,
                            onBack = { navigator.goBack() },
                            transitionSpec = {
                                slideInHorizontally(tween(400), initialOffsetX = { it }) togetherWith
                                    slideOutHorizontally(tween(400), targetOffsetX = { -it / 3 })
                            },
                            popTransitionSpec = {
                                slideInHorizontally(tween(400), initialOffsetX = { -it / 3 }) togetherWith
                                    slideOutHorizontally(tween(400), targetOffsetX = { it })
                            },
                            predictivePopTransitionSpec = {
                                slideInHorizontally(tween(400), initialOffsetX = { -it / 3 }) togetherWith
                                    slideOutHorizontally(tween(400), targetOffsetX = { it })
                            },
{{- if .Spec.HasAndroidExtra "nav3-scenes" }}
                            sceneStrategies = listOf(bottomSheetStrategy, dialogStrategy),
{{- end }}
                            entryProvider = entryProvider {
                                entry<ShellRoute> {
                                    SharedRoute {
{{- if $shell }}
                                        ResponsiveNavigationShell(navigator = navigator) {
                                            RootNavDisplay(navigator, navigationState)
                                        }
{{- else }}
                                        RootNavDisplay(navigator, navigationState)
{{- end }}
                                    }
                                }

                                // Screens pushed above the shell go here.
                                // kmp-scaffold:entries
                            }
                        )
                    }
                }
{{- if .Spec.HasAndroidExtra "connectivity-banner" }}

                ConnectivityBanner(modifier = Modifier.align(Alignment.TopCenter))
{{- end }}
{{- if .Spec.HasAndroidExtra "snackbar-host" }}

                // A sibling of the whole NavDisplay rather than nested inside the
                // shell, so it stays mounted across every top-level route.
                AppSnackbarHost(
                    hostState = snackbarHostState,
                    modifier = Modifier
                        .align(Alignment.BottomCenter)
                        .windowInsetsPadding(WindowInsets.safeDrawing.only(WindowInsetsSides.Bottom))
{{- if $shell }}
                        .padding(bottom = rememberSnackbarBottomPadding(isShellActive))
{{- end }}
                )
{{- end }}
            }
        }
    }
}

/** The inner display: whichever root tab is currently selected. */
@Composable
private fun RootNavDisplay(
    navigator: Navigator,
    navigationState: NavigationState,
) {
    NavDisplay(
        backStack = navigationState.currentBackStack,
        onBack = { navigator.goBack() },
        transitionSpec = { fadeIn(tween(200)) togetherWith fadeOut(tween(200)) },
        entryProvider = entryProvider {
{{- range .Tabs }}
            {{ .Camel }}Entries()
{{- end }}
            // kmp-scaffold:root-entries
        }
    )
}
{{end}}


