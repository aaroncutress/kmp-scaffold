import org.koin.android.ext.android.get
{{- end }}
import {{ .Spec.Package }}.di.appModules
import org.koin.android.ext.koin.androidContext
import org.koin.core.context.startKoin

class {{ .Spec.AppClassName }} : Application(){{ if .Spec.HasPack "images" }}, SingletonImageLoader.Factory{{ end }} {

    override fun onCreate() {
        super.onCreate()

        startKoin {
            androidContext(this@{{ .Spec.AppClassName }})
            modules(appModules)
        }
    }
{{- if .Spec.HasPack "images" }}

    /**
     * Coil shares the app's Ktor client, so authentication headers, timeouts
