{{define "android/AppSerializers.kt"}}
package {{ .Spec.Package }}

import androidx.savedstate.serialization.SavedStateConfiguration
import {{ .Spec.Package }}.core.navigation.coreNavSerializers
{{- range .Tabs }}
import {{ $.Spec.Package }}.feature.{{ .Pkg }}.api.{{ .Camel }}NavSerializers
{{- end }}
import kotlinx.serialization.modules.SerializersModule
import kotlinx.serialization.modules.plus

/**
 * Every feature module registers its own Route subclasses next to where they
 * are defined (see [{{ .Spec.Package }}.core.navigation.routeSerializers]), so
 * adding a Route only means editing the file you are already in. This file just
 * sums those contributions - a brand-new feature module adds one line here.
 */
val appNavSerializersModule: SerializersModule = listOf(
    coreNavSerializers,
{{- range .Tabs }}
    {{ .Camel }}NavSerializers,
{{- end }}
    // kmp-scaffold:serializers
).reduce { combined, module -> combined + module }

val appNavSavedStateConfiguration: SavedStateConfiguration = SavedStateConfiguration {
    serializersModule = appNavSerializersModule
}
{{end}}


{{define "android/App.kt"}}
{{ $shell := eq .Spec.AndroidLayout "nav3-shell" -}}
package {{ .Spec.Package }}

import androidx.compose.animation.SharedTransitionLayout
import androidx.compose.animation.core.tween
import androidx.compose.animation.fadeIn
import androidx.compose.animation.fadeOut
import androidx.compose.animation.slideInHorizontally
