{{define "android/app.build.gradle.kts"}}
import org.jetbrains.kotlin.gradle.dsl.JvmTarget
{{- if .Spec.HasPack "secrets" }}
import java.util.Properties
{{- end }}

plugins {
    alias(libs.plugins.androidApplication)
    alias(libs.plugins.composeCompiler)
    alias(libs.plugins.kotlin.serialization)
    alias(libs.plugins.kotlin.parcelize)
}
{{ if .Spec.HasPack "secrets" }}
@Suppress("UNCHECKED_CAST")
val secretsProps = rootProject.extra["secretsProps"] as Properties
{{ end }}
android {
    namespace = "{{ .Spec.Package }}"
    compileSdk = libs.versions.android.compileSdk.get().toInt()
    buildToolsVersion = libs.versions.android.buildTools.get()

    defaultConfig {
        applicationId = "{{ .Spec.ApplicationID }}"
        minSdk = libs.versions.android.minSdk.get().toInt()
        targetSdk = libs.versions.android.targetSdk.get().toInt()
        versionCode = libs.versions.app.versionCode.get().toInt()
        versionName = libs.versions.app.versionName.get()
{{- if .Spec.HasPack "secrets" }}

        // Every key in secrets.properties becomes a manifest placeholder, e.g.
        // ${MAPS_API_KEY} in AndroidManifest.xml. Add a secret to the file and
        // it is picked up here automatically.
        // noinspection WrongGradleMethod
        secretsProps.entries.forEach { entry ->
            manifestPlaceholders[entry.key.toString()] = entry.value.toString()
        }
{{- end }}
    }

    buildFeatures {
        compose = true
    }

    packaging {
        resources {
            excludes += "/META-INF/{AL2.0,LGPL2.1}"
        }
    }

    buildTypes {
        getByName("release") {
            isMinifyEnabled = false
            proguardFiles(getDefaultProguardFile("proguard-android-optimize.txt"), "proguard-rules.pro")
        }
    }

    compileOptions {
        sourceCompatibility = JavaVersion.VERSION_{{ .Spec.JVMTarget }}
        targetCompatibility = JavaVersion.VERSION_{{ .Spec.JVMTarget }}
    }
}

kotlin {
    compilerOptions {
        jvmTarget = JvmTarget.JVM_{{ .Spec.JVMTarget }}
    }
}

dependencies {
    // Feature modules. `kmp-scaffold add feature` appends here.
    // kmp-scaffold:feature-deps
{{- range .Tabs }}
    implementation(projects.feature.{{ camel .Name }}.api)
    implementation(projects.feature.{{ camel .Name }}.impl)
{{- end }}

    // Core modules
    implementation(projects.core.navigation)
    implementation(projects.core.ui)

    // Shared business logic
    implementation(projects.sharedLogic)
{{- if .Spec.HasAndroidExtra "splash-screen" }}

    // Android core
    implementation(libs.androidx.core.splashscreen)
{{- end }}

    // Bundled dependencies
    implementation(libs.bundles.compose)
    implementation(libs.bundles.navigation)
    implementation(libs.bundles.adaptive)
    implementation(libs.bundles.ui.extras)
    implementation(libs.bundles.koin)

    implementation(libs.androidx.compose.runtime.saveable)
    debugImplementation(libs.androidx.compose.ui.tooling)

    // Architecture and core extensions
    implementation(libs.androidx.activity.compose)
    implementation(libs.androidx.core.ktx)
    implementation(libs.androidx.lifecycle.viewmodel)
    implementation(libs.androidx.lifecycle.viewmodel.compose)
    implementation(libs.androidx.lifecycle.runtime.compose)
{{- if .Spec.HasPack "images" }}

    // Images
    implementation(libs.coil.compose)
    implementation(libs.coil.network.ktor)
{{- end }}
{{- if .Spec.HasPack "maps" }}
    implementation(libs.maps.compose)
{{- end }}
{{- if .Spec.HasPack "charts" }}
    implementation(libs.vico.compose)
    implementation(libs.vico.compose.m3)
{{- end }}
{{- if .Spec.HasPack "logger" }}
    implementation(libs.logger)
{{- end }}
{{- if .Spec.HasPack "ble" }}
    implementation(libs.kable)
{{- end }}

    testImplementation(libs.junit)
    androidTestImplementation(libs.androidx.testExt.junit)
    androidTestImplementation(libs.androidx.espresso.core)
}
{{end}}


