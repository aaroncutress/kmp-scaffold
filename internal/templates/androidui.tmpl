{{define "android/Theme.kt"}}
package {{ .Spec.Package }}.core.ui.theme

import android.os.Build
import androidx.compose.foundation.isSystemInDarkTheme
import androidx.compose.material3.ColorScheme
import androidx.compose.material3.MaterialTheme
import androidx.compose.material3.Shapes
import androidx.compose.material3.Typography
import androidx.compose.material3.dynamicDarkColorScheme
import androidx.compose.material3.dynamicLightColorScheme
import androidx.compose.runtime.Composable
import androidx.compose.runtime.ReadOnlyComposable
import androidx.compose.ui.platform.LocalContext

/**
 * The app theme.
 *
 * `dynamicColor` follows the user's wallpaper on Android 12+. Turn it off to
 * keep the brand palette in [{{ .Spec.TypePrefix }}LightColorScheme] /
 * [{{ .Spec.TypePrefix }}DarkColorScheme] on every device.
 */
@Composable
fun {{ .Spec.ThemeName }}(
    darkTheme: Boolean = isSystemInDarkTheme(),
    dynamicColor: Boolean = true,
    content: @Composable () -> Unit
) {
    val colorScheme: ColorScheme = when {
        dynamicColor && Build.VERSION.SDK_INT >= Build.VERSION_CODES.S -> {
            val context = LocalContext.current
            if (darkTheme) dynamicDarkColorScheme(context) else dynamicLightColorScheme(context)
        }

        darkTheme -> {{ .Spec.TypePrefix }}DarkColorScheme
        else -> {{ .Spec.TypePrefix }}LightColorScheme
    }

    MaterialTheme(
        colorScheme = colorScheme,
        typography = {{ .Spec.TypePrefix }}Typography,
        shapes = {{ .Spec.TypePrefix }}Shapes,
        content = content
    )
}

/**
 * Theme accessors, including the ones Material does not provide.
 *
 * Reading `{{ .Spec.ThemeName }}.spacing.md` rather than a raw `16.dp` is what
 * keeps spacing consistent when the design changes.
 */
object {{ .Spec.ThemeName }} {
    val colorScheme: ColorScheme
        @Composable @ReadOnlyComposable get() = MaterialTheme.colorScheme

    val typography: Typography
        @Composable @ReadOnlyComposable get() = MaterialTheme.typography

    val shapes: Shapes
        @Composable @ReadOnlyComposable get() = MaterialTheme.shapes

    val spacing = SpacingTokens
    val borders = BorderTokens
    val opacities = OpacityTokens
}
{{end}}


