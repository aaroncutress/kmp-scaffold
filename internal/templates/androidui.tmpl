/**
 * Bottom inset reserved by the floating navigation bar.
 *
 * Screens inside the shell should add this to their scrollable content's
 * *content padding*, not as an outer Modifier - that way content scrolls and
 * fades behind the bar instead of being clipped above it. It is zero on wide
 * layouts, where the navigation is at the side instead.
 */
val LocalNavigationBarsInset = compositionLocalOf<Dp> { 0.dp }

/**
 * The adaptive navigation container.
 *
 * Compact widths get a floating bottom bar, medium widths an expandable rail,
 * and large widths a permanent drawer. The content slot holds the NavDisplay
 * itself and is never torn down when the layout changes, so navigation
 * transitions survive a rotation or a window resize.
 */
@Composable
fun ResponsiveNavigationShell(
    navigator: Navigator,
    showShell: Boolean = true,
    content: @Composable () -> Unit
) {
    val windowSizeClass = currentWindowAdaptiveInfoV2().windowSizeClass
    val isExtraLarge =
        windowSizeClass.isWidthAtLeastBreakpoint(WindowSizeClass.WIDTH_DP_EXTRA_LARGE_LOWER_BOUND)
    val isLarge =
        windowSizeClass.isWidthAtLeastBreakpoint(WindowSizeClass.WIDTH_DP_LARGE_LOWER_BOUND)
    val isMedium =
        windowSizeClass.isWidthAtLeastBreakpoint(WindowSizeClass.WIDTH_DP_MEDIUM_LOWER_BOUND)

    Row(modifier = Modifier.fillMaxSize()) {
        AnimatedVisibility(
            visible = showShell,
            enter = expandHorizontally(expandFrom = Alignment.Start) + fadeIn(),
            exit = shrinkHorizontally(shrinkTowards = Alignment.Start) + fadeOut()
        ) {
            when {
                isLarge || isExtraLarge -> PermanentNavDrawer(navigator)
                isMedium -> ExpandableNavRail(navigator)
            }
        }

        val sideNavActive = showShell && (isMedium || isLarge || isExtraLarge)
        val consumedInsets = if (sideNavActive) {
            WindowInsets.safeDrawing.only(WindowInsetsSides.Start)
        } else {
            WindowInsets(0, 0, 0, 0)
        }

        val navBarInset = if (!isMedium && showShell) {
            WindowInsets.safeDrawing.asPaddingValues().calculateBottomPadding() +
                {{ .Spec.ThemeName }}.spacing.xxxl + {{ .Spec.ThemeName }}.spacing.md
        } else {
            0.dp
        }

        CompositionLocalProvider(LocalNavigationBarsInset provides navBarInset) {
            Box(
                modifier = Modifier
                    .weight(1f)
                    .fillMaxHeight()
                    .consumeWindowInsets(consumedInsets)
            ) {
                content()

                if (!isMedium) {
                    // A soft fade so scrolling content does not cut off abruptly
                    // behind the floating bar.
                    this@Row.AnimatedVisibility(
                        visible = showShell,
                        modifier = Modifier
                            .align(Alignment.BottomCenter)
                            .fillMaxWidth(),
                        enter = fadeIn(),
                        exit = fadeOut()
                    ) {
                        Box(
                            modifier = Modifier
                                .fillMaxWidth()
                                .height(navBarInset)
                                .background(
                                    Brush.verticalGradient(
                                        colors = listOf(
                                            Color.Transparent,
                                            MaterialTheme.colorScheme.background.copy(alpha = 0.85f),
                                            MaterialTheme.colorScheme.background
                                        )
                                    )
                                )
                        )
                    }

                    this@Row.AnimatedVisibility(
                        visible = showShell,
                        modifier = Modifier.align(Alignment.BottomCenter),
                        enter = slideInVertically(initialOffsetY = { it }) + fadeIn(),
                        exit = slideOutVertically(targetOffsetY = { it }) + fadeOut()
                    ) {
                        FloatingNavBar(navigator = navigator)
                    }
                }
            }
        }
    }
}

/**
 * Clearance a global SnackbarHost needs to sit above [FloatingNavBar]. Only
 * non-zero while the shell's own tabs are showing on a compact width, since
 * that is the only time the floating bar is on screen.
 */
@Composable
fun rememberSnackbarBottomPadding(isShellActive: Boolean): Dp {
    val windowSizeClass = currentWindowAdaptiveInfoV2().windowSizeClass
    val isCompact =
        !windowSizeClass.isWidthAtLeastBreakpoint(WindowSizeClass.WIDTH_DP_MEDIUM_LOWER_BOUND)
    return if (isShellActive && isCompact) {
        {{ .Spec.ThemeName }}.spacing.xxxl + {{ .Spec.ThemeName }}.spacing.xl
    } else {
        0.dp
    }
}

/**
 * The compact-width navigation bar.
 *
 * The selection pill follows your finger while dragging (with a haptic tick per
 * item crossed) and only commits the navigation on release, so a mis-aimed tap
 * can be corrected without leaving the current screen.
 */
@Composable
fun FloatingNavBar(
    navigator: Navigator,
    modifier: Modifier = Modifier,
) {
    val coroutineScope = rememberCoroutineScope()
    val density = LocalDensity.current
    val haptics = LocalHapticFeedback.current

    var containerWidth by remember { mutableIntStateOf(0) }
    val itemWidth = if (NavigationItemsList.isNotEmpty() && containerWidth > 0) {
        containerWidth / NavigationItemsList.size.toFloat()
    } else {
        0f
    }

    val initialIndex = NavigationItemsList
        .indexOfFirst { it.route == navigator.state.currentRoot }
        .coerceAtLeast(0)

    val animatedOffset = remember { Animatable(0f) }
    var isDragging by remember { mutableStateOf(false) }
    var activeIndex by remember { mutableIntStateOf(initialIndex) }
    var initialised by remember { mutableStateOf(false) }

    LaunchedEffect(navigator.state.currentRoot, itemWidth) {
        val newIndex = NavigationItemsList
            .indexOfFirst { it.route == navigator.state.currentRoot }
            .coerceAtLeast(0)
        activeIndex = newIndex

        if (itemWidth <= 0f) return@LaunchedEffect
        val targetX = newIndex * itemWidth
        if (!initialised) {
            // Snap on first layout, otherwise the pill flies in from zero.
            animatedOffset.snapTo(targetX)
            initialised = true
        } else if (!isDragging && animatedOffset.targetValue != targetX) {
            animatedOffset.animateTo(
                targetX,
                spring(stiffness = Spring.StiffnessMedium, dampingRatio = 0.76f)
            )
        }
    }

    Box(
        modifier = modifier
            .windowInsetsPadding(
                WindowInsets.safeDrawing.only(WindowInsetsSides.Horizontal + WindowInsetsSides.Bottom)
            )
            .padding(
                start = {{ .Spec.ThemeName }}.spacing.xl,
                end = {{ .Spec.ThemeName }}.spacing.xl,
                bottom = {{ .Spec.ThemeName }}.spacing.md
            )
    ) {
        Surface(
            shape = CircleShape,
            color = MaterialTheme.colorScheme.surfaceContainerHighest,
            tonalElevation = 4.dp,
            modifier = Modifier.height({{ .Spec.ThemeName }}.spacing.xxxl)
        ) {
            Box(
                modifier = Modifier
                    .fillMaxHeight()
                    .onSizeChanged { containerWidth = it.width }
                    .pointerInput(itemWidth) {
                        if (itemWidth <= 0f) return@pointerInput
                        awaitEachGesture {
                            val down = awaitFirstDown(
                                requireUnconsumed = false,
                                pass = PointerEventPass.Initial
                            )
                            isDragging = true

                            val maxOffset = containerWidth - itemWidth
                            // Past either end the pill only moves a quarter as
                            // far, which reads as resistance rather than a stop.
                            fun rubberBand(raw: Float): Float = when {
                                raw < 0f -> raw * 0.25f
                                raw > maxOffset -> maxOffset + (raw - maxOffset) * 0.25f
                                else -> raw
                            }

                            var lastIndex = (down.position.x / itemWidth).toInt()
                                .coerceIn(0, NavigationItemsList.lastIndex)
                            activeIndex = lastIndex

                            coroutineScope.launch {
                                animatedOffset.animateTo(
                                    rubberBand(down.position.x - itemWidth / 2),
                                    spring(stiffness = 1000f, dampingRatio = 0.85f)
                                )
                            }
                            haptics.performHapticFeedback(HapticFeedbackType.LongPress)

                            do {
                                val event = awaitPointerEvent(pass = PointerEventPass.Initial)
                                val change = event.changes.firstOrNull()
                                if (change != null && change.pressed) {
                                    val dragX = change.position.x
                                    coroutineScope.launch {
                                        animatedOffset.animateTo(
                                            rubberBand(dragX - itemWidth / 2),
                                            spring(stiffness = 1000f, dampingRatio = 0.85f)
                                        )
                                    }

                                    val hovered = (dragX / itemWidth).toInt()
                                        .coerceIn(0, NavigationItemsList.lastIndex)
                                    if (hovered != lastIndex) {
                                        haptics.performHapticFeedback(HapticFeedbackType.VirtualKey)
                                        lastIndex = hovered
                                        activeIndex = hovered
                                    }
                                    // Only claim the gesture once it is clearly a
                                    // drag, so plain taps still behave as taps.
                                    if (abs(dragX - down.position.x) > 4f) {
                                        change.consume()
                                    }
                                }
                            } while (event.changes.any { it.pressed })

                            isDragging = false

                            val nearest = activeIndex
                            coroutineScope.launch {
                                launch {
                                    animatedOffset.animateTo(
                                        nearest * itemWidth,
                                        spring(stiffness = Spring.StiffnessMedium, dampingRatio = 0.76f)
                                    )
                                }
                                // Let the pill start moving before the screen
                                // swaps underneath it.
                                delay(50.milliseconds)
                                navigator.navigate(NavigationItemsList[nearest].route)
                            }
                        }
                    }
            ) {
                if (containerWidth > 0) {
                    val maxOffset = containerWidth - itemWidth
                    val currentOffset = animatedOffset.value
                    val clamped = currentOffset.coerceIn(0f, maxOffset)

                    // Squash the pill horizontally when it is dragged past an end.
                    val scaleX = when {
                        currentOffset < 0f -> 1f + (currentOffset / itemWidth) * 0.5f
                        currentOffset > maxOffset -> 1f - ((currentOffset - maxOffset) / itemWidth) * 0.5f
                        else -> 1f
                    }.coerceIn(0.65f, 1f)

                    val originX = when {
                        currentOffset < 0f -> 0f
                        currentOffset > maxOffset -> 1f
                        else -> 0.5f
                    }

                    Box(
                        modifier = Modifier
                            .offset { IntOffset(clamped.roundToInt(), 0) }
                            .graphicsLayer {
                                this.scaleX = scaleX
                                this.transformOrigin = TransformOrigin(originX, 0.5f)
                            }
                            .width(with(density) { itemWidth.toDp() })
                            .fillMaxHeight()
                            .padding({{ .Spec.ThemeName }}.spacing.xs)
                            .clip(CircleShape)
                            .background(MaterialTheme.colorScheme.primaryContainer)
                    )
                }

                Row(
                    modifier = Modifier.fillMaxSize(),
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    NavigationItemsList.forEachIndexed { index, item ->
                        val selected = index == activeIndex
                        val contentColour = if (selected) {
                            MaterialTheme.colorScheme.onPrimaryContainer
                        } else {
                            MaterialTheme.colorScheme.onSurfaceVariant
                        }

                        Column(
                            modifier = Modifier.weight(1f),
                            horizontalAlignment = Alignment.CenterHorizontally,
                            verticalArrangement = Arrangement.Center
                        ) {
                            Icon(
                                imageVector = item.icon,
                                contentDescription = item.label,
                                modifier = Modifier.size(20.dp),
                                tint = contentColour
                            )
                            Spacer(modifier = Modifier.height({{ .Spec.ThemeName }}.spacing.xxs))
                            Text(
                                text = item.label,
                                style = MaterialTheme.typography.labelSmall,
                                maxLines = 1,
                                overflow = TextOverflow.Ellipsis,
                                color = contentColour,
                                fontWeight = if (selected) FontWeight.Bold else FontWeight.Normal
                            )
                        }
                    }
                }
            }
        }
    }
}

/** Medium widths: a rail that expands to show labels. */
@Composable
fun ExpandableNavRail(navigator: Navigator) {
    var expanded by rememberSaveable { mutableStateOf(false) }

    val startInset = WindowInsets.safeDrawing.asPaddingValues()
        .calculateStartPadding(LocalLayoutDirection.current)
    val collapsedWidth = {{ .Spec.ThemeName }}.spacing.xxxl + {{ .Spec.ThemeName }}.spacing.lg
    val expandedWidth = {{ .Spec.ThemeName }}.spacing.hero + {{ .Spec.ThemeName }}.spacing.xxl

    val railWidth by animateDpAsState(
        targetValue = (if (expanded) expandedWidth else collapsedWidth) + startInset,
        animationSpec = spring(stiffness = Spring.StiffnessLow),
        label = "railWidth"
    )

    Surface(
        modifier = Modifier
            .width(railWidth)
            .fillMaxHeight(),
        color = MaterialTheme.colorScheme.surfaceContainerLowest
    ) {
        Column(
            modifier = Modifier
                .fillMaxSize()
                .windowInsetsPadding(
                    WindowInsets.safeDrawing.only(WindowInsetsSides.Vertical + WindowInsetsSides.Start)
                )
                .padding(horizontal = {{ .Spec.ThemeName }}.spacing.md),
            horizontalAlignment = Alignment.Start
        ) {
            Spacer(modifier = Modifier.height({{ .Spec.ThemeName }}.spacing.md))
            IconButton(onClick = { expanded = !expanded }) {
                Icon(MaterialSymbols.Rounded.Menu, contentDescription = "Toggle navigation labels")
            }
            Spacer(modifier = Modifier.height({{ .Spec.ThemeName }}.spacing.lg))

            VerticalNavigationItems(navigator = navigator, showLabels = expanded)

            Spacer(modifier = Modifier.height({{ .Spec.ThemeName }}.spacing.md))
        }
    }
}

/** Large widths: a permanent drawer with labels always visible. */
@Composable
fun PermanentNavDrawer(navigator: Navigator) {
    Surface(
        modifier = Modifier
            .width({{ .Spec.ThemeName }}.spacing.hero + {{ .Spec.ThemeName }}.spacing.xxl)
            .fillMaxHeight(),
        color = MaterialTheme.colorScheme.surfaceContainerLow
    ) {
        Column(
            modifier = Modifier
                .fillMaxSize()
                .windowInsetsPadding(
                    WindowInsets.safeDrawing.only(WindowInsetsSides.Vertical + WindowInsetsSides.Start)
                )
                .padding(horizontal = {{ .Spec.ThemeName }}.spacing.md),
            horizontalAlignment = Alignment.Start
        ) {
            Spacer(modifier = Modifier.height({{ .Spec.ThemeName }}.spacing.xl))
            VerticalNavigationItems(navigator = navigator, showLabels = true)
            Spacer(modifier = Modifier.height({{ .Spec.ThemeName }}.spacing.md))
        }
    }
}

/**
 * The shared body of the rail and the drawer: the same drag-to-select pill as
 * the floating bar, laid out vertically.
 */
@Composable
private fun VerticalNavigationItems(
    navigator: Navigator,
    showLabels: Boolean,
) {
    val coroutineScope = rememberCoroutineScope()
    val density = LocalDensity.current
    val haptics = LocalHapticFeedback.current
    val activeRoute = navigator.state.currentRoot

    val windowSizeClass = currentWindowAdaptiveInfoV2().windowSizeClass
    val isCompactHeight =
        !windowSizeClass.isHeightAtLeastBreakpoint(WindowSizeClass.HEIGHT_DP_MEDIUM_LOWER_BOUND)
    val itemHeight = if (isCompactHeight) 48.dp else 56.dp
    val itemHeightPx = with(density) { itemHeight.toPx() }

    val initialIndex = NavigationItemsList.indexOfFirst { it.route == activeRoute }.coerceAtLeast(0)
    val animatedOffset = remember { Animatable(0f) }
    var isDragging by remember { mutableStateOf(false) }
    var activeIndex by remember { mutableIntStateOf(initialIndex) }
    var parentCoordinates by remember { mutableStateOf<LayoutCoordinates?>(null) }
    val itemPositions = remember { mutableStateMapOf<Int, Float>() }
    var initialised by remember { mutableStateOf(false) }

    LaunchedEffect(
        activeRoute,
        itemPositions[NavigationItemsList.indexOfFirst { it.route == activeRoute }]
    ) {
        val newIndex = NavigationItemsList.indexOfFirst { it.route == activeRoute }.coerceAtLeast(0)
        activeIndex = newIndex
        val targetY = itemPositions[newIndex] ?: return@LaunchedEffect

        if (!initialised) {
            animatedOffset.snapTo(targetY)
            initialised = true
        } else if (!isDragging && animatedOffset.targetValue != targetY) {
            animatedOffset.animateTo(
                targetY,
                spring(stiffness = Spring.StiffnessMedium, dampingRatio = 0.76f)
            )
        }
    }

    Box(
        modifier = Modifier
            .fillMaxWidth()
            .onGloballyPositioned { parentCoordinates = it }
            .pointerInput(Unit) {
                awaitEachGesture {
                    val down = awaitFirstDown(requireUnconsumed = false, pass = PointerEventPass.Initial)
                    if (itemPositions.isEmpty()) return@awaitEachGesture
                    isDragging = true

                    val minY = itemPositions[0] ?: 0f
                    val maxY = itemPositions[NavigationItemsList.lastIndex] ?: 0f
                    fun rubberBand(raw: Float): Float = when {
                        raw < minY -> minY + (raw - minY) * 0.25f
                        raw > maxY -> maxY + (raw - maxY) * 0.25f
                        else -> raw
                    }
                    fun nearest(y: Float): Int =
                        itemPositions.minByOrNull { (_, top) -> abs(y - (top + itemHeightPx / 2)) }?.key
                            ?: activeIndex

                    var lastIndex = nearest(down.position.y)
                    activeIndex = lastIndex

                    coroutineScope.launch {
                        animatedOffset.animateTo(
                            rubberBand(down.position.y - itemHeightPx / 2),
                            spring(stiffness = 1000f, dampingRatio = 0.85f)
                        )
                    }
                    haptics.performHapticFeedback(HapticFeedbackType.LongPress)

                    do {
                        val event = awaitPointerEvent(pass = PointerEventPass.Initial)
                        val change = event.changes.firstOrNull()
                        if (change != null && change.pressed) {
                            val dragY = change.position.y
                            coroutineScope.launch {
                                animatedOffset.animateTo(
                                    rubberBand(dragY - itemHeightPx / 2),
                                    spring(stiffness = 1000f, dampingRatio = 0.85f)
                                )
                            }
                            val hovered = nearest(dragY)
                            if (hovered != lastIndex) {
                                haptics.performHapticFeedback(HapticFeedbackType.VirtualKey)
                                lastIndex = hovered
                                activeIndex = hovered
                            }
                            if (abs(dragY - down.position.y) > 4f) {
                                change.consume()
                            }
                        }
                    } while (event.changes.any { it.pressed })

                    isDragging = false

                    val target = activeIndex
                    coroutineScope.launch {
                        launch {
                            animatedOffset.animateTo(
                                itemPositions[target] ?: 0f,
                                spring(stiffness = Spring.StiffnessMedium, dampingRatio = 0.76f)
                            )
                        }
                        delay(50.milliseconds)
                        navigator.navigate(NavigationItemsList[target].route)
                    }
                }
            }
    ) {
        if (itemPositions.containsKey(activeIndex)) {
            val minY = itemPositions[0] ?: 0f
            val maxY = itemPositions[NavigationItemsList.lastIndex] ?: 0f
            val currentOffset = animatedOffset.value
            val clamped = currentOffset.coerceIn(minY, maxY)

            val scaleY = when {
                currentOffset < minY -> 1f + ((currentOffset - minY) / itemHeightPx) * 0.5f
                currentOffset > maxY -> 1f - ((currentOffset - maxY) / itemHeightPx) * 0.5f
                else -> 1f
            }.coerceIn(0.65f, 1f)

            val originY = when {
                currentOffset < minY -> 0f
                currentOffset > maxY -> 1f
                else -> 0.5f
            }

            Box(
                modifier = Modifier
                    .offset { IntOffset(0, clamped.roundToInt()) }
                    .graphicsLayer {
                        this.scaleY = scaleY
                        this.transformOrigin = TransformOrigin(0.5f, originY)
                    }
                    .fillMaxWidth()
                    .height(itemHeight)
                    .clip(CircleShape)
                    .background(MaterialTheme.colorScheme.primaryContainer)
            )
        }

        Column(modifier = Modifier.fillMaxWidth()) {
            NavigationItemsList.forEachIndexed { index, item ->
                val selected = index == activeIndex
                val contentColour = if (selected) {
                    MaterialTheme.colorScheme.onPrimaryContainer
                } else {
                    MaterialTheme.colorScheme.onSurfaceVariant
                }

                Row(
                    modifier = Modifier
                        .fillMaxWidth()
                        .height(itemHeight)
                        .onGloballyPositioned { coords ->
                            parentCoordinates?.let { parent ->
                                itemPositions[index] = parent.localPositionOf(coords, Offset.Zero).y
                            }
                        }
                        .clip(CircleShape)
                        .clickable {
                            coroutineScope.launch {
                                activeIndex = index
                                launch {
                                    animatedOffset.animateTo(
                                        itemPositions[index] ?: 0f,
                                        spring(
                                            stiffness = Spring.StiffnessMedium,
                                            dampingRatio = 0.76f
                                        )
                                    )
                                }
                                delay(50.milliseconds)
                                navigator.navigate(item.route)
                            }
                        }
                        .padding(horizontal = {{ .Spec.ThemeName }}.spacing.md),
                    verticalAlignment = Alignment.CenterVertically,
                    horizontalArrangement = Arrangement.Start
                ) {
                    Box(modifier = Modifier.size(24.dp), contentAlignment = Alignment.Center) {
                        Icon(
                            item.icon,
                            contentDescription = item.label,
                            tint = contentColour,
                            modifier = Modifier.size(20.dp)
                        )
                    }
                    AnimatedVisibility(
                        visible = showLabels,
                        enter = fadeIn() + expandHorizontally(expandFrom = Alignment.Start),
                        exit = fadeOut() + shrinkHorizontally(shrinkTowards = Alignment.Start)
                    ) {
                        Text(
                            text = item.label,
                            color = contentColour,
                            style = MaterialTheme.typography.labelLarge,
                            maxLines = 1,
                            modifier = Modifier.padding(start = {{ .Spec.ThemeName }}.spacing.md),
                            fontWeight = if (selected) FontWeight.Bold else FontWeight.Normal
                        )
                    }
                }
            }
        }
    }
}
