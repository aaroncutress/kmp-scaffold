{{define "android/Tokens.kt"}}
package {{ .Spec.Package }}.core.ui.theme

import androidx.compose.ui.unit.Dp
import androidx.compose.ui.unit.dp

/**
 * Design tokens Material does not define. Reach for these instead of literal
 * dp values so spacing stays consistent and is changeable in one place.
 */
object SpacingTokens {
    val none: Dp = 0.dp
    val xxs: Dp = 2.dp
    val xs: Dp = 4.dp
    val sm: Dp = 8.dp
    val md: Dp = 16.dp
    val lg: Dp = 24.dp
    val xl: Dp = 32.dp
    val xxl: Dp = 48.dp
    val xxxl: Dp = 64.dp
    val hero: Dp = 128.dp
}

object BorderTokens {
    val none: Dp = 0.dp
    val thin: Dp = 1.dp
    val thick: Dp = 2.dp
}

object OpacityTokens {
    const val HOVER = 0.04f
    const val FOCUS = 0.12f
    const val PRESSED = 0.16f
    const val DRAGGED = 0.08f
    const val DISABLED = 0.38f
    const val OVERLAY = 0.40f
}
{{end}}


