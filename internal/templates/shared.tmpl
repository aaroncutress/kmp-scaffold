package {{ .Spec.Package }}.di

{{- if .Spec.HasSharedUtil "database" }}
import {{ .Spec.Package }}.core.database.AppDatabase
import {{ .Spec.Package }}.core.database.createRoomDatabaseBuilder
import {{ .Spec.Package }}.core.database.finalizeRoomDatabase
{{- end }}
{{- if .Spec.HasSharedUtil "ktor-engine" }}
import {{ .Spec.Package }}.core.network.KtorNetworkEngine
{{- end }}
{{- if .Spec.HasSharedUtil "clock" }}
import {{ .Spec.Package }}.core.util.Clock
import {{ .Spec.Package }}.core.util.SystemClock
{{- end }}
{{- if .Spec.HasSharedUtil "network-observer" }}
import {{ .Spec.Package }}.core.util.NetworkViewModel
{{- end }}
{{- if .Spec.HasSharedUtil "settings" }}
import {{ .Spec.Package }}.feature.settings.di.settingsModule
{{- end }}
import org.koin.core.module.Module
{{- if .Spec.HasSharedUtil "network-observer" }}
import org.koin.core.module.dsl.viewModelOf
{{- end }}
import org.koin.dsl.module

/**
 * Cross-cutting singletons. Feature-specific bindings belong in that feature's
 * own module, which is then listed in [sharedModules] below.
 */
val coreModule = module {
{{- if .Spec.HasSharedUtil "ktor-engine" }}
    single { KtorNetworkEngine.createClient(getOrNull()) }
{{- end }}
{{- if .Spec.HasSharedUtil "clock" }}
    single<Clock> { SystemClock }
{{- end }}
{{- if .Spec.HasSharedUtil "network-observer" }}
    viewModelOf(::NetworkViewModel)
{{- end }}
{{- if .Spec.HasSharedUtil "database" }}

    single<AppDatabase> { finalizeRoomDatabase(createRoomDatabaseBuilder()) }
{{- end }}
}

/**
 * The whole shared graph. A new feature adds one line to [includes].
 */
val sharedModules = module {
    includes(
        coreModule,
{{- if .Spec.HasSharedUtil "settings" }}
        settingsModule,
{{- end }}
        // kmp-scaffold:shared-modules
    )
}

/** Bindings that only one platform can provide (HTTP engine, storage, ...). */
expect val platformModule: Module

val appModules = listOf(sharedModules, platformModule)
{{end}}


{{define "shared/SharedModules.android.kt"}}
package {{ .Spec.Package }}.di

{{- if .Spec.HasSharedUtil "settings" }}
import android.content.Context
{{- end }}
{{- if .Spec.HasSharedUtil "network-observer" }}
import {{ .Spec.Package }}.core.util.AndroidNetworkObserver
import {{ .Spec.Package }}.core.util.NetworkObserver
{{- end }}
{{- if .Spec.HasSharedUtil "settings" }}
import com.russhwolf.settings.Settings
import com.russhwolf.settings.SharedPreferencesSettings
{{- end }}
{{- if .Spec.HasSharedUtil "ktor-engine" }}
import io.ktor.client.engine.HttpClientEngine
import io.ktor.client.engine.okhttp.OkHttp
import okhttp3.OkHttpClient
{{- end }}
{{- if or (.Spec.HasSharedUtil "network-observer") (.Spec.HasSharedUtil "settings") }}
import org.koin.android.ext.koin.androidContext
{{- end }}
import org.koin.core.module.Module
import org.koin.dsl.module
{{- if .Spec.HasSharedUtil "ktor-engine" }}
import java.util.concurrent.TimeUnit
{{- end }}

actual val platformModule: Module = module {
{{- if .Spec.HasSharedUtil "ktor-engine" }}
    single<OkHttpClient> {
        OkHttpClient.Builder()
            .connectTimeout(15, TimeUnit.SECONDS)
            .readTimeout(15, TimeUnit.SECONDS)
            .writeTimeout(15, TimeUnit.SECONDS)
            .build()
    }

    single<HttpClientEngine> {
        OkHttp.create { preconfigured = get() }
    }
{{- end }}
{{- if .Spec.HasSharedUtil "settings" }}

    single<Settings> {
        val context = androidContext()
        SharedPreferencesSettings(
            context.getSharedPreferences("{{ lowerAlnum .Spec.Name }}_prefs", Context.MODE_PRIVATE)
        )
    }
{{- end }}
{{- if .Spec.HasSharedUtil "network-observer" }}

    single<NetworkObserver> { AndroidNetworkObserver(androidContext()) }
{{- end }}
}
{{end}}


{{define "shared/SharedModules.ios.kt"}}
package {{ .Spec.Package }}.di

{{- if .Spec.HasSharedUtil "network-observer" }}
import {{ .Spec.Package }}.core.util.IosNetworkObserver
import {{ .Spec.Package }}.core.util.NetworkObserver
{{- end }}
{{- if .Spec.HasSharedUtil "settings" }}
import com.russhwolf.settings.NSUserDefaultsSettings
import com.russhwolf.settings.Settings
{{- end }}
{{- if .Spec.HasSharedUtil "ktor-engine" }}
import io.ktor.client.engine.HttpClientEngine
import io.ktor.client.engine.darwin.Darwin
{{- end }}
import org.koin.core.module.Module
import org.koin.dsl.module
{{- if .Spec.HasSharedUtil "settings" }}
import platform.Foundation.NSUserDefaults
{{- end }}

actual val platformModule: Module = module {
{{- if .Spec.HasSharedUtil "settings" }}
    single<Settings> { NSUserDefaultsSettings(NSUserDefaults.standardUserDefaults) }
{{- end }}
{{- if .Spec.HasSharedUtil "ktor-engine" }}
    single<HttpClientEngine> { Darwin.create() }
{{- end }}
{{- if .Spec.HasSharedUtil "network-observer" }}
    single<NetworkObserver> { IosNetworkObserver() }
{{- end }}
}
{{end}}


{{define "shared/KoinHelper.kt"}}
package {{ .Spec.Package }}

import {{ .Spec.Package }}.di.appModules
import kotlinx.cinterop.BetaInteropApi
import kotlinx.cinterop.ObjCClass
import kotlinx.cinterop.getOriginalKotlinClass
import org.koin.core.component.KoinComponent
import org.koin.core.context.startKoin

/**
 * Swift's entry point into the shared DI graph.
 *
 * Call `KoinHelper.shared.setup()` once at app launch, then resolve with
 * `KoinHelper.shared.get(objCClass: MyViewModel.self)`.
 *
 * It is deliberately not called `initKoin`: Kotlin/Native renames anything
 * starting with `init` when exporting to Objective-C.
 */
object KoinHelper : KoinComponent {

    fun setup() {
        startKoin {
            modules(appModules)
        }
    }

    @OptIn(BetaInteropApi::class)
    fun get(objCClass: ObjCClass): Any {
        val kClass = getOriginalKotlinClass(objCClass)
            ?: throw IllegalArgumentException(
                "Could not find the Kotlin class behind Objective-C type: $objCClass"
            )
        return getKoin().get(clazz = kClass, qualifier = null, parameters = null)
    }
}
{{end}}
