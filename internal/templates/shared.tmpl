{{define "shared/SettingsViewModel.kt"}}
package {{ .Spec.Package }}.feature.settings.presentation

import {{ .Spec.Package }}.core.presentation.BaseViewModel
import {{ .Spec.Package }}.feature.settings.domain.AppSetting
import {{ .Spec.Package }}.feature.settings.domain.AppSettingsRegistry
import {{ .Spec.Package }}.feature.settings.domain.AppSettingsRepository
import {{ .Spec.Package }}.feature.settings.domain.ThemeMode
import com.rickclephas.kmp.observableviewmodel.stateIn
import kotlinx.coroutines.flow.SharingStarted
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.combine

data class SettingsUiState(
    val themeMode: ThemeMode = ThemeMode.SYSTEM,
    val analyticsEnabled: Boolean = false,
)

class SettingsViewModel internal constructor(
    private val appSettingsRepository: AppSettingsRepository
) : BaseViewModel<SettingsUiState>() {

    override val uiState: StateFlow<SettingsUiState> = combine(
        AppSettingsRegistry.ThemeChoice.flow,
        AppSettingsRegistry.AnalyticsEnabled.flow
    ) { themeMode, analyticsEnabled ->
        SettingsUiState(themeMode = themeMode, analyticsEnabled = analyticsEnabled)
    }.stateIn(
        viewModelScope = viewModelScope,
        started = SharingStarted.WhileSubscribed(5000),
        initialValue = SettingsUiState()
    )

    /** One updater for every setting, whatever its type. */
    fun <T> updateSetting(setting: AppSetting<T>, value: T) {
        appSettingsRepository.set(setting, value)
    }
}
{{end}}


{{define "shared/SettingsViewModelTest.kt"}}
package {{ .Spec.Package }}.feature.settings.presentation

import app.cash.turbine.test
import {{ .Spec.Package }}.feature.settings.data.AppSettingsRepositoryImpl
import {{ .Spec.Package }}.feature.settings.domain.AppSettingsRegistry
import {{ .Spec.Package }}.feature.settings.domain.ThemeMode
import com.russhwolf.settings.MapSettings
import kotlinx.coroutines.test.runTest
import kotlin.test.Test
import kotlin.test.assertEquals

class SettingsViewModelTest {

    @Test
    fun `updating a setting is reflected in ui state`() = runTest {
        val repository = AppSettingsRepositoryImpl(MapSettings())
        val viewModel = SettingsViewModel(repository)

        viewModel.uiState.test {
            assertEquals(ThemeMode.SYSTEM, awaitItem().themeMode)

            viewModel.updateSetting(AppSettingsRegistry.ThemeChoice, ThemeMode.DARK)
            assertEquals(ThemeMode.DARK, awaitItem().themeMode)

            cancelAndIgnoreRemainingEvents()
        }
    }
}
{{end}}


{{define "shared/AppDatabase.kt"}}
package {{ .Spec.Package }}.core.database

import androidx.room.ConstructedBy
import androidx.room.Database
import androidx.room.RoomDatabase
import androidx.room.RoomDatabaseConstructor

/**
 * The app's Room database.
 *
 * Add an entity to [entities] and a DAO accessor below, then bump [VERSION] and
 * add a migration. Schemas are exported to `sharedLogic/schemas/`, which is what
 * makes migrations reviewable in a pull request.
 */
@Database(
    entities = [],
    version = AppDatabase.VERSION,
    exportSchema = true
)
@ConstructedBy(AppDatabaseConstructor::class)
abstract class AppDatabase : RoomDatabase() {
    companion object {
        const val VERSION = 1
        const val FILE_NAME = "{{ lowerAlnum .Spec.Name }}.db"
    }
}

// Room's KSP processor generates the actual implementation per platform.
@Suppress("NO_ACTUAL_FOR_EXPECT", "KotlinNoActualForExpect")
expect object AppDatabaseConstructor : RoomDatabaseConstructor<AppDatabase> {
    override fun initialize(): AppDatabase
}
{{end}}


{{define "shared/DatabaseBuilder.kt"}}
package {{ .Spec.Package }}.core.database

import androidx.room.RoomDatabase
import androidx.sqlite.driver.bundled.BundledSQLiteDriver
import kotlinx.coroutines.Dispatchers

/**
 * Each platform knows where its database file belongs, so the builder is
 * expect/actual; everything after that (driver, dispatcher, migrations) is
 * shared and lives in [finalizeRoomDatabase].
 */
expect fun createRoomDatabaseBuilder(): RoomDatabase.Builder<AppDatabase>

fun finalizeRoomDatabase(builder: RoomDatabase.Builder<AppDatabase>): AppDatabase =
    builder
        .setDriver(BundledSQLiteDriver())
        .setQueryCoroutineContext(Dispatchers.IO)
        .build()
{{end}}


{{define "shared/DatabaseBuilder.android.kt"}}
package {{ .Spec.Package }}.core.database

import android.content.Context
import androidx.room.Room
import androidx.room.RoomDatabase
import org.koin.core.component.KoinComponent
import org.koin.core.component.get

private object DatabaseContext : KoinComponent

actual fun createRoomDatabaseBuilder(): RoomDatabase.Builder<AppDatabase> {
    val context = DatabaseContext.get<Context>()
    val dbFile = context.getDatabasePath(AppDatabase.FILE_NAME)
    return Room.databaseBuilder<AppDatabase>(
        context = context.applicationContext,
        name = dbFile.absolutePath
    )
}
{{end}}


{{define "shared/DatabaseBuilder.apple.kt"}}
package {{ .Spec.Package }}.core.database

import androidx.room.Room
import androidx.room.RoomDatabase
import kotlinx.cinterop.ExperimentalForeignApi
import platform.Foundation.NSDocumentDirectory
import platform.Foundation.NSFileManager
import platform.Foundation.NSURL
import platform.Foundation.NSUserDomainMask

@OptIn(ExperimentalForeignApi::class)
actual fun createRoomDatabaseBuilder(): RoomDatabase.Builder<AppDatabase> {
    val documentsUrl: NSURL = NSFileManager.defaultManager.URLForDirectory(
        directory = NSDocumentDirectory,
        inDomain = NSUserDomainMask,
        appropriateForURL = null,
        create = false,
        error = null
    ) ?: error("Could not locate the documents directory for the database")

    val dbPath = requireNotNull(documentsUrl.path) + "/" + AppDatabase.FILE_NAME
    return Room.databaseBuilder<AppDatabase>(name = dbPath)
}
{{end}}


{{define "shared/SwiftPagingPresenter.kt"}}
package {{ .Spec.Package }}.core.util

import androidx.paging.PagingData
import androidx.paging.cachedIn
import com.rickclephas.kmp.observableviewmodel.ViewModelScope
import kotlinx.coroutines.flow.Flow

/**
 * Paging's Flow<PagingData<T>> does not cross the Swift boundary usefully on
 * its own. Wrap a pager here and expose the wrapper so both platforms consume
 * the same object; SKIE turns the flow into an AsyncSequence for Swift.
 */
class SwiftPagingPresenter<T : Any>(
    pagingFlow: Flow<PagingData<T>>,
    scope: ViewModelScope,
) {
    val pages: Flow<PagingData<T>> = pagingFlow.cachedIn(scope.coroutineScope)
}
{{end}}


