{{define "shared/KtorNetworkEngine.kt"}}
package {{ .Spec.Package }}.core.network

import io.ktor.client.HttpClient
import io.ktor.client.HttpClientConfig
import io.ktor.client.engine.HttpClientEngine
import io.ktor.client.plugins.HttpTimeout
import io.ktor.client.plugins.contentnegotiation.ContentNegotiation
import io.ktor.serialization.kotlinx.json.json
import kotlinx.serialization.json.Json

/**
 * Builds the shared [HttpClient].
 *
 * The engine is passed in rather than chosen here: the DI graph supplies OkHttp
 * on Android and Darwin on iOS, which keeps this file free of platform code and
 * lets tests substitute MockEngine.
 */
object KtorNetworkEngine {

    val jsonConfig = Json {
        ignoreUnknownKeys = true
        coerceInputValues = true
        encodeDefaults = true
    }

    fun createClient(engine: HttpClientEngine? = null): HttpClient {
        val config: HttpClientConfig<*>.() -> Unit = {
            install(ContentNegotiation) {
                json(jsonConfig)
            }
            install(HttpTimeout) {
                connectTimeoutMillis = 15_000
                requestTimeoutMillis = 30_000
            }
        }
        return if (engine != null) HttpClient(engine, config) else HttpClient(config)
    }
}
{{end}}


{{define "shared/AppSetting.kt"}}
package {{ .Spec.Package }}.feature.settings.domain

import com.russhwolf.settings.Settings
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.asStateFlow

/**
 * A single configuration value that knows how to read and write itself, and
 * exposes its current value as a [StateFlow].
 *
 * Adding a setting is a one-line change in [AppSettingsRegistry] - no new
 * repository method, no new flow plumbing.
 */
sealed class AppSetting<T> {
    abstract val key: String
    abstract val defaultValue: T

    protected val _flow: MutableStateFlow<T> by lazy { MutableStateFlow(defaultValue) }
    val flow: StateFlow<T> by lazy { _flow.asStateFlow() }

    val value: T get() = _flow.value

    abstract fun read(settings: Settings): T
    abstract fun write(settings: Settings, value: T)

    /** Called once by the repository at launch to sync disk state into the flow. */
    fun initialize(settings: Settings) {
        _flow.value = read(settings)
    }

    /** Writes to disk and updates the in-memory stream. */
    fun update(settings: Settings, value: T) {
        write(settings, value)
        _flow.value = value
    }

    data class Toggle(
        override val key: String,
        override val defaultValue: Boolean
    ) : AppSetting<Boolean>() {
        override fun read(settings: Settings): Boolean = settings.getBoolean(key, defaultValue)
        override fun write(settings: Settings, value: Boolean) = settings.putBoolean(key, value)
    }

    data class IntValue(
        override val key: String,
        override val defaultValue: Int
    ) : AppSetting<Int>() {
        override fun read(settings: Settings): Int = settings.getInt(key, defaultValue)
        override fun write(settings: Settings, value: Int) = settings.putInt(key, value)
    }

    data class Text(
        override val key: String,
        override val defaultValue: String
    ) : AppSetting<String>() {
        override fun read(settings: Settings): String = settings.getString(key, defaultValue)
        override fun write(settings: Settings, value: String) = settings.putString(key, value)
    }

    data class Choice<E : Enum<E>>(
        override val key: String,
        override val defaultValue: E,
        private val valueOf: (String) -> E
    ) : AppSetting<E>() {
        override fun read(settings: Settings): E {
            val savedName = settings.getStringOrNull(key) ?: return defaultValue
            return try {
                valueOf(savedName)
            } catch (_: IllegalArgumentException) {
                defaultValue
            }
        }

        override fun write(settings: Settings, value: E) = settings.putString(key, value.name)
    }
}

/** How the app should follow the system theme. */
enum class ThemeMode { SYSTEM, LIGHT, DARK }

/**
 * The registry of every app setting. Add new settings here; everything else
 * (persistence, flows, the settings screen's state) follows automatically.
 */
object AppSettingsRegistry {
    val ThemeChoice = AppSetting.Choice(
        key = "theme_mode",
        defaultValue = ThemeMode.SYSTEM,
        valueOf = { ThemeMode.valueOf(it) }
    )
    val AnalyticsEnabled = AppSetting.Toggle(key = "analytics_enabled", defaultValue = false)

    /** Master list the repository iterates at startup. Register new settings here too. */
    val allSettings: List<AppSetting<*>> = listOf(ThemeChoice, AnalyticsEnabled)
}
{{end}}


{{define "shared/AppSettingsRepository.kt"}}
package {{ .Spec.Package }}.feature.settings.domain

/**
 * Routes setting writes to disk and keeps the in-memory flows in step.
 *
 * Reads do not go through here - collect [AppSetting.flow] directly.
 */
interface AppSettingsRepository {
    fun <T> set(setting: AppSetting<T>, value: T)
}
{{end}}


{{define "shared/AppSettingsRepositoryImpl.kt"}}
package {{ .Spec.Package }}.feature.settings.data

import {{ .Spec.Package }}.feature.settings.domain.AppSetting
import {{ .Spec.Package }}.feature.settings.domain.AppSettingsRegistry
import {{ .Spec.Package }}.feature.settings.domain.AppSettingsRepository
import com.russhwolf.settings.Settings

internal class AppSettingsRepositoryImpl(private val settings: Settings) : AppSettingsRepository {

    init {
        // Hydrate every registered setting from disk exactly once, at construction.
        AppSettingsRegistry.allSettings.forEach { it.initialize(settings) }
    }

    override fun <T> set(setting: AppSetting<T>, value: T) {
        setting.update(settings, value)
    }
}
{{end}}


